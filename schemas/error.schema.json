{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codesentinel.local/schemas/error.schema.json",
  "title": "CodeSentinel Error Envelope",
  "type": "object",
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "details": {},
    "hint": {
      "type": "string"
    },
    "doc_url": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
