# CodeSentinel - Environment Variable Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# Required Configuration
# =============================================================================

# OpenAI API Key - Required for AI-driven code security analysis
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# Optional Configuration
# =============================================================================

# OpenAI API Base URL (optional, usually no change needed)
# Modify if using a proxy service or enterprise edition
OPENAI_API_BASE=https://api.openai.com/v1

# AI Model (optional, default: gpt-4o-mini)
# Use a stable, cost-effective model available to your account
OPENAI_MODEL=gpt-4o-mini

# Request Timeout (optional, seconds, default: 60)
# Increase for large file analysis
REQUEST_TIMEOUT=60

# Max Retries (optional, default: 3)
# Number of retries on API request failure
MAX_RETRIES=3

# =============================================================================
# Advanced Configuration (generally no changes needed)
# =============================================================================

# Wrapper CLI configuration (codesentinel.ps1)
# These environment variables override config file values:
# CODESENTINEL_ANALYZER_MODE=hybrid
# CODESENTINEL_FALLBACK_POLICY=fail-open
# CODESENTINEL_MIN_SEVERITY=low
# CODESENTINEL_FORMAT=json
# CODESENTINEL_ERROR_FORMAT=json
# CODESENTINEL_FAIL_ON=high
# CODESENTINEL_MIN_CONFIDENCE=0.7
# CODESENTINEL_MIN_CONFIDENCE_LEVEL=medium
# CODESENTINEL_EXIT_ZERO_ON_FINDINGS=false
# CODESENTINEL_PROGRESS=false
# CODESENTINEL_RULESET_VERSION=core-1.0.0
# CODESENTINEL_ENABLE=secrets,deps
# CODESENTINEL_INCLUDE=src/**,scripts/**
# CODESENTINEL_EXCLUDE=**/*.generated.*,tests/fixtures/**
# CODESENTINEL_RESPECT_GITIGNORE=true
# CODESENTINEL_NO_DEFAULT_EXCLUDES=false
# CODESENTINEL_INCREMENTAL=false
# CODESENTINEL_DIFF_FROM=
# CODESENTINEL_CACHE_PATH=
# CODESENTINEL_NO_CACHE_WRITE=false
# CODESENTINEL_POLICY_SCOPE=all_findings
# CODESENTINEL_BASELINE_REQUIRED=false
# CODESENTINEL_REQUIRE_AUTHORITATIVE=false
# CODESENTINEL_REQUIRE_TRUSTED_INCREMENTAL=false
# CODESENTINEL_POLICY_PROFILE=
# CODESENTINEL_SECRET_SCAN=false
# CODESENTINEL_SECRET_ENTROPY_THRESHOLD=4.5
# CODESENTINEL_SECRET_MIN_TOKEN_LENGTH=20
# CODESENTINEL_SECRET_MAX_FILE_BYTES=1048576
# CODESENTINEL_DEPENDENCY_SCAN=false
# CODESENTINEL_DEPENDENCY_ADVISORY_FILE=
# CODESENTINEL_DEPENDENCY_POLICY_FILE=
# CODESENTINEL_DEPENDENCY_MAX_FILE_BYTES=2097152

# Log Level (optional: DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Verbose Logging (optional, true/false)
VERBOSE_LOGGING=false

# Temporary File Directory (optional, defaults to system temp)
TEMP_DIR=%TEMP%

# =============================================================================
# Configuration Notes
# =============================================================================
#
# 1. Get your OpenAI API key:
#    - Visit https://platform.openai.com
#    - Sign up / Log in
#    - Go to API Keys page
#    - Click "Create new secret key"
#    - Copy the key and paste it above
#
# 2. Configuration precedence:
#    CLI args > Environment variables > .env file > Defaults
#
# 3. Security reminders:
#    - Never commit your API key to version control
#    - Rotate API keys regularly
#    - Monitor API usage to avoid unexpected charges
#
# =============================================================================
